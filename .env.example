NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Optional: enables LLM moderation of punishment text (gambling / NSFW / gore /
# illegal). When OPENAI_API_KEY is unset, moderation is skipped (fail-open).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible third-party endpoint. Leave blank for
# the official OpenAI API. Must include the version path, e.g. https://host/v1
OPENAI_BASE_URL=

CRON_SECRET=
